<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same palette as the in-app dark theme (BgDark / SurfDark / AccentDark
         in LuachApp.kt), used so the home-screen widget matches the app
         regardless of the device's own day/night setting. -->
    <color name="widget_bg">#1B2A3B</color>
    <color name="widget_accent">#D8E6FF</color>
    <color name="widget_sub">#8A94AA</color>

    <!-- Light-theme variant, matching the app's own light palette
         (SurfDay / AccentDay / SubDay in LuachApp.kt) - used when the
         widget is configured for "light" or "follow the app" and the
         app's own dark-mode setting is off. -->
    <color name="widget_bg_light">#E8E0D0</color>
    <color name="widget_accent_light">#1A2744</color>
    <color name="widget_sub_light">#5A6070</color>
</resources>
