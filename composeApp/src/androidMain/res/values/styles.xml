<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme.Material3.DayNight.NoActionBar comes from com.google.android.material -
         this is the app's actual root Android theme (declared in AndroidManifest.xml),
         separate from Compose's own Material3 used inside the UI. -->
    <style name="Theme.LuachItim" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>
</resources>
