<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission to read files from storage (for PDF picker).
         READ_MEDIA_IMAGES intentionally omitted: the picker only ever
         requests application/pdf documents, never images. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Permission to push diary events into the device's calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Android 11+ file access -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
    </queries>

    <application
        android:name=".LuachApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="לוח עתים לבינה"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuachItim"
        android:extractNativeLibs="true"
        android:appCategory="productivity">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Marks this as one of the device's calendar/diary apps, the
                 same category the built-in Calendar app declares. Lets
                 launchers and system UI (app groupings, "open with" pickers,
                 assistant/voice routing, etc.) recognize it as a calendar
                 app rather than a generic utility - purely a local manifest
                 declaration, no network or account involved. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity>

        <!-- Shown once when the widget is added, to pick theme/text size -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.LuachItim">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: פרשת השבוע + today's Hebrew date -->
        <receiver
            android:name=".widget.LuachWidgetProvider"
            android:exported="true"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- Exempt implicit broadcasts (see LuachWidgetProvider kdoc) - lets the
                 widget refresh itself right at midnight instead of waiting for the
                 next updatePeriodMillis tick. -->
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/luach_widget_info" />
        </receiver>

        <!-- Used only to share the generated .ics export file via the share sheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
